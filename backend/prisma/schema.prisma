// YESE — Core Platform schema (Phase 1)
//
// Conventions (SRS v1.2 §8.1, NFR-SEC-01):
//  - Tables and columns are snake_case in PostgreSQL (@@map / @map);
//    models and fields stay camelCase in TypeScript.
//  - UUID primary keys (@db.Uuid).
//  - Every tenant-owned table carries a non-null tenant_id, junction tables included.
//  - Uniqueness that belongs to a school is scoped by tenant_id.
//  - The audit log is append-only from the application's point of view.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum InstitutionType {
  primary
  secondary
  university

  @@map("institution_type")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// The four fixed base roles (two-layer RBAC, FR-ID-04).
enum RoleArchetype {
  admin
  staff
  parent
  student

  @@map("role_archetype")
}

enum ModuleCategory {
  core
  business
  extension

  @@map("module_category")
}

enum StaffCategory {
  teaching
  non_teaching

  @@map("staff_category")
}

enum Gender {
  male
  female

  @@map("gender")
}

/// inactive: the student has left the school (the record and its history stay).
enum StudentStatus {
  active
  inactive

  @@map("student_status")
}

/// active: in the section now; transferred: moved to another section; withdrawn: left during the year.
enum EnrollmentStatus {
  active
  transferred
  withdrawn

  @@map("enrollment_status")
}

/// Assessment workflow: the teacher enters marks (open) and submits them;
/// the exam officer validates (or sends back) and then locks.
enum AssessmentStatus {
  open
  submitted
  validated
  locked

  @@map("assessment_status")
}

enum StaffStatus {
  active
  inactive

  @@map("staff_status")
}

// -------------------------------------------------------------- tenancy

/// One school (tenant). Root of all tenant-scoped data.
model Tenant {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  /// Subdomain / X-Tenant value, e.g. "northfield".
  slug      String          @unique
  type      InstitutionType
  status    TenantStatus    @default(active)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  roles           Role[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  auditLogs       AuditLog[]
  sessions        Session[]
  modules         TenantModule[]
  academicYears   AcademicYear[]
  terms           Term[]
  classes         SchoolClass[]
  sections        Section[]
  subjects        Subject[]
  classSubjects   ClassSubject[]
  staffMembers    StaffMember[]
  teacherAssignments TeacherAssignment[]
  assessments     Assessment[]
  students        Student[]
  enrollments     Enrollment[]
  marks           Mark[]
  resultPublications ResultPublication[]

  @@map("tenants")
}

// ------------------------------------------------------------- identity

/// An account. Belongs to exactly one school (FR-ID-03), except platform
/// Super Admins, which have tenant_id NULL and is_super_admin = true.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String?    @map("tenant_id") @db.Uuid
  email              String
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  status             UserStatus @default(active)
  isSuperAdmin       Boolean    @default(false) @map("is_super_admin")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles     UserRole[]
  auditLogs AuditLog[]
  sessions  Session[]
  staff     StaffMember?

  // Email is unique per school. (Super Admin emails are checked in code,
  // because PostgreSQL treats NULL tenant_id values as distinct.)
  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

/// One signed-in browser session (FR-ID-01, FR-ID-03 session timeout).
/// Holds the current refresh token as a SHA-256 hash, never the token itself.
/// Rotated on every refresh; the previous hash is kept so a stolen, already
/// used token can be detected and the whole session revoked.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  /// NULL for platform (Super Admin) sessions, like users.tenant_id.
  tenantId          String?   @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  previousTokenHash String?   @unique @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  /// Last authenticated request; drives the 15-minute idle timeout.
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  /// Absolute end of the session, whatever the activity.
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// logout | idle | password_changed | token_reuse | account_disabled
  revokedReason     String?   @map("revoked_reason")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

// ----------------------------------------------------------------- RBAC

/// A role inside one school: one of the four fixed archetypes (is_system)
/// or a custom role built by the school (FR-ID-05).
model Role {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  description String?
  /// Set for the four base roles; null for custom roles.
  archetype   RoleArchetype?
  /// Base roles cannot be renamed or deleted.
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Platform-wide catalogue of modules (the Module Registry grows in Phase 1.5).
model Module {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  name        String
  category    ModuleCategory
  description String?
  /// Codes of the modules this one needs (FR-PL-03), e.g. assessment -> {academic, enrollment}.
  dependsOn   String[]       @default([]) @map("depends_on")

  permissions Permission[]
  tenants     TenantModule[]

  @@map("modules")
}

/// Which modules a school has switched on (Module Registry, FR-PL-03).
/// Core modules are always on and have no row here.
model TenantModule {
  tenantId     String    @map("tenant_id") @db.Uuid
  moduleCode   String    @map("module_code")
  active       Boolean   @default(true)
  changedAt    DateTime  @default(now()) @updatedAt @map("changed_at") @db.Timestamptz(3)
  changedById  String?   @map("changed_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module Module @relation(fields: [moduleCode], references: [code], onDelete: Restrict)

  @@id([tenantId, moduleCode])
  @@map("tenant_modules")
}

/// Platform-wide permission catalogue: module.resource.action (FR-ID-06).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  moduleId    String  @map("module_id") @db.Uuid
  description String?

  module Module           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  roles  RolePermission[]

  @@index([moduleId])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

// ------------------------------------------------------------- academic
// Academic structure (module "academic", Phase 2). Classes, sections and
// subjects are permanent; what changes each year (enrollment, teacher
// assignments) refers to an academic year and a section.

/// A school year, e.g. "2026-2027". At most one per school is current.
model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  terms              Term[]
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]
  enrollments        Enrollment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_years")
}

/// A term (trimester, semester) inside an academic year. Terms never overlap.
model Term {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  assessments  Assessment[]
  publications ResultPublication[]

  @@unique([academicYearId, name])
  @@index([tenantId])
  @@map("terms")
}

/// A class (grade level), e.g. "Form 1". `level` orders the classes.
model SchoolClass {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  level     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sections Section[]
  subjects ClassSubject[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("classes")
}

/// A section (stream) of a class, e.g. "A" -> "Form 1 A". Students are enrolled into sections.
model Section {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  name      String
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schoolClass        SchoolClass         @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]
  enrollments        Enrollment[]
  publications       ResultPublication[]

  @@unique([classId, name])
  @@index([tenantId])
  @@map("sections")
}

/// A subject taught in the school, e.g. MATH "Mathematics".
model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classes            ClassSubject[]
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

/// The subjects of a class with their coefficient (weight in averages).
model ClassSubject {
  tenantId    String @map("tenant_id") @db.Uuid
  classId     String @map("class_id") @db.Uuid
  subjectId   String @map("subject_id") @db.Uuid
  coefficient Int

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([classId, subjectId])
  @@index([tenantId])
  @@index([subjectId])
  @@map("class_subjects")
}

// ---------------------------------------------------------------- staff
// Staff module (Phase 2). A staff record exists whether or not the person
// signs in; when they do, it is linked to their user account (one record per
// account). Teacher assignments (W9) refer to staff records.

/// A member of staff, teaching or not, e.g. "STF-0007 Ngwa Brenda, Mathematics teacher".
model StaffMember {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  /// School-wide staff number, e.g. "STF-0007" (generated when not given).
  staffNumber String        @map("staff_number")
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  email       String?
  phone       String?
  /// Job title, e.g. "Mathematics teacher", "Bursar".
  position    String
  category    StaffCategory @default(teaching)
  /// inactive: has left the school; the record is kept for history.
  status      StaffStatus   @default(active)
  hireDate    DateTime?     @map("hire_date") @db.Date
  /// The person's user account in the same school, if they sign in.
  userId      String?       @unique @map("user_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments TeacherAssignment[]

  @@unique([tenantId, staffNumber])
  @@index([tenantId])
  @@map("staff_members")
}

// ------------------------------------------------------- teaching
// Teacher assignment (Phase 2): who teaches which subject to which section
// in a school year. Needs the Academic and Staff modules. Attendance and
// Assessment use it so teachers only see their own classes.

/// "In 2026-2027, Ngwa Brenda teaches Mathematics to Form 1 A". One teacher per subject per section per year.
model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  staffMemberId  String   @map("staff_member_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, sectionId, subjectId])
  @@index([tenantId])
  @@index([staffMemberId])
  @@index([sectionId])
  @@map("teacher_assignments")
}

// ------------------------------------------------------- students
// Students (Phase 2) and their enrollment in a section for a school year.
// A student has at most one active enrollment per year; a transfer closes
// the old row (transferred) and opens a new one, so marks and registers
// keep pointing at the section the student was in.

/// A student of the school. The guardian is the first contact (parent accounts come later).
model Student {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  matricule            String
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  gender               Gender
  dateOfBirth          DateTime?     @map("date_of_birth") @db.Date
  placeOfBirth         String?       @map("place_of_birth")
  guardianName         String?       @map("guardian_name")
  guardianPhone        String?       @map("guardian_phone")
  guardianRelationship String?       @map("guardian_relationship")
  status               StudentStatus @default(active)
  admittedOn           DateTime?     @map("admitted_on") @db.Date
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  marks       Mark[]

  @@unique([tenantId, matricule])
  @@index([tenantId])
  @@map("students")
}

/// "Abena Ada is in Form 1 A for 2026-2027, since 7 Sep 2026".
model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  status         EnrollmentStatus @default(active)
  enrolledOn     DateTime         @map("enrolled_on") @db.Date
  leftOn         DateTime?        @map("left_on") @db.Date
  reason         String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([academicYearId, sectionId])
  @@index([studentId])
  @@map("enrollments")
}

// ----------------------------------------------------- assessment
// Assessment (Phase 3): tests, sequences and exams of one subject in one
// section, in one term. Marks are added once Enrollment provides the
// students of each section.

/// "Sequence 1" in Mathematics, Form 1 A, First Term: marked out of maxScore, counted weight times in the term average.
model Assessment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  termId         String           @map("term_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  subjectId      String           @map("subject_id") @db.Uuid
  name           String
  maxScore       Int              @default(20) @map("max_score")
  weight         Int              @default(1)
  heldOn         DateTime?        @map("held_on") @db.Date
  status         AssessmentStatus @default(open)
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(3)
  validatedAt    DateTime?        @map("validated_at") @db.Timestamptz(3)
  lockedAt       DateTime?        @map("locked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks        Mark[]

  @@unique([termId, sectionId, subjectId, name])
  @@index([tenantId])
  @@index([sectionId])
  @@index([academicYearId])
  @@map("assessments")
}

/// One student's mark in one assessment: a score (0 to maxScore, 2 decimals) or absent.
model Mark {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  score        Decimal? @db.Decimal(5, 2)
  absent       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@map("marks")
}

/// Published term results of one section: a frozen copy of the results at publication time.
/// Report cards print from it; republishing replaces it (version + 1).
model ResultPublication {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  termId            String   @map("term_id") @db.Uuid
  sectionId         String   @map("section_id") @db.Uuid
  version           Int      @default(1)
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedByUserId String   @map("published_by_user_id") @db.Uuid
  publishedByName   String   @map("published_by_name")
  /// SectionResults as computed when published (see results.service.ts)
  snapshot          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Restrict)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([termId, sectionId])
  @@index([tenantId])
  @@map("result_publications")
}

// ---------------------------------------------------------------- audit

/// Append-only record of security-relevant actions (FR-PL-06, FR-ID-09).
/// tenant_id is NULL for platform-level events (e.g. tenant creation).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// e.g. "tenant.created", "auth.login.failed", "role.permissions.updated"
  action      String
  entity      String?
  entityId    String?  @map("entity_id") @db.Uuid
  detail      Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
