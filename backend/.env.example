# ---- Database: Neon PostgreSQL ----
# Pooled connection (has -pooler in the host) — used by the app.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/yese?sslmode=require"
# Direct connection (no -pooler) — used by Prisma migrations.
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/yese?sslmode=require"

# ---- Server ----
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ---- Auth (used from Phase 1) ----
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"
# Access tokens are short-lived (SRS FR-ID-01): 15m, 900 (seconds), 1h ...
JWT_EXPIRES_IN="15m"
# Optional. Sign out after this many idle minutes (SRS: 15) and after this
# many hours in total, whatever the activity.
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12
