# ---- Database: Neon PostgreSQL ----
# Pooled connection (has -pooler in the host) — used by the app.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/yese?sslmode=require"
# Direct connection (no -pooler) — used by Prisma migrations.
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/yese?sslmode=require"

# ---- Server ----
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ---- Auth (used from Phase 1) ----
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
